#!/bin/sh
# RoninSuite portable launcher. All application dependencies and runtimes are
# bundled beside this script; it does not install packages on first run.
set -eu

SELF=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")
ROOT=$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd)
# The copied native libraries were built against glibc 2.44. Fail with a clear
# message before Python emits a less useful missing-version-symbol error.
HOST_GLIBC=$(getconf GNU_LIBC_VERSION 2>/dev/null | sed -n 's/^glibc //p' || true)
if [ -n "$HOST_GLIBC" ] && [ "$(printf '%s\n' 2.44 "$HOST_GLIBC" | sort -V | head -n 1)" != "2.44" ]; then
    echo "RoninSuite: Linux x86-64 with glibc 2.44+ required (found $HOST_GLIBC)." >&2
    exit 1
fi
PATH="$ROOT/bin:$PATH"
PYTHONHOME="$ROOT/toolchain/python"
PYTHONPATH="$ROOT/toolchain/site-packages:$ROOT${PYTHONPATH:+:$PYTHONPATH}"
LD_LIBRARY_PATH="$ROOT/toolchain/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PATH PYTHONHOME PYTHONPATH LD_LIBRARY_PATH
[ -n "${RONIN_HOME:-}" ] && export RONIN_HOME || true

exec "$ROOT/toolchain/python/bin/python3.13" -m ronin "$@"

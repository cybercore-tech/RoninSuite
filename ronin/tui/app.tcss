/* ══ RoninSuite · cybercore ══ */

Screen {
    background: $background;
}

Header {
    background: $panel;
    color: $accent;
    text-style: bold;
}

Footer {
    background: $footer-background;
}

#ctxbar {
    dock: top;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $foreground;
    border-bottom: hkey $primary;
}

TabbedContent {
    height: 1fr;
}

Tabs {
    background: $panel;
}

Tab {
    color: $primary 70%;
    text-style: none;
}

Tab:hover { color: $accent; }

Tab.-active, Tab:focus {
    color: $accent;
    background: $panel;
    text-style: bold;
}

Underline > .underline--bar {
    color: $accent;
}

TabPane {
    padding: 1 2;
}

Pane {
    height: 1fr;
}

/* section labels / heads */
#dash-context, #dash-alerts, #tools-ctx, #cl-head, #cl-detail, #up-head,
#tb-head, #rep-head, #find-head, #run-title, Label {
    color: $foreground;
}

Rule {
    color: $primary 40%;
    margin: 0;
}

#banner {
    content-align: center middle;
    width: 100%;
    height: auto;
    padding-top: 1;
}

#banner-sub {
    content-align: center middle;
    width: 100%;
    color: $primary 60%;
    text-style: italic;
    margin-bottom: 1;
}

#dash-row {
    height: auto;
    min-height: 8;
}

#dash-row > Static {
    width: 1fr;
    padding: 1 2;
    background: $panel;
    border: round $primary 40%;
    margin-right: 1;
}

DataTable {
    height: 1fr;
    background: $surface;
    border: round $primary 30%;
    scrollbar-size-vertical: 1;
}

DataTable > .datatable--header {
    text-style: bold;
}

Input {
    background: $surface;
    border: tall $primary 40%;
}

Input:focus {
    border: tall $accent;
}

Select {
    margin-bottom: 1;
}

Button {
    border: none;
    background: $panel;
    color: $primary;
    text-style: bold;
}

Button:hover {
    background: $primary 20%;
    color: $accent;
}

Button.-primary {
    background: $primary 25%;
    color: $accent;
}

Button.-primary:hover {
    background: $secondary 30%;
}

RichLog {
    height: 1fr;
    min-height: 6;
    background: $surface;
    border: round $primary 30%;
    color: $foreground;
}

#warn, #run-status {
    color: $warning;
    text-style: bold;
    padding: 0 1;
}

#scope-status {
    height: auto;
    padding: 0 1;
}

/* action rows */
#rep-actions, #cl-actions, #up-actions, #tb-actions, #modal-buttons {
    height: auto;
    padding-top: 1;
}
#rep-actions Button, #cl-actions Button, #up-actions Button,
#tb-actions Button, #modal-buttons Button {
    margin-right: 2;
}

#rep-opts {
    height: auto;
}
#rep-opts > Vertical { width: auto; margin-right: 4; }

#cl-detail {
    height: auto;
    min-height: 5;
    padding: 1 2;
    background: $panel;
    border: round $secondary 40%;
    margin-top: 1;
}

/* modals */
TextPrompt, EngagementPicker, RunConfig, FindingDetail {
    align: center middle;
}

#modal {
    width: 66;
    height: auto;
    max-height: 92%;          /* frame never taller than the screen */
    padding: 1 2;
    background: $panel;
    border: thick $primary;
}

#modal-title { height: 1; }

#modal-scroll {
    height: auto;
    max-height: 16;           /* long forms scroll inside here */
}

#modal-scroll Label { margin-top: 1; }
#modal-scroll Label:first-of-type { margin-top: 0; }

#modal-buttons {           /* always pinned, whatever the field count */
    dock: bottom;
    height: 3;
    padding-top: 1;
    background: $panel;
}

#modal-wide {
    width: 88%;
    max-width: 130;
    height: 84%;
    padding: 1 2;
    background: $panel;
    border: thick $primary;
}

#modal-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#modal Input, #modal-wide Input {
    margin-bottom: 1;
}
